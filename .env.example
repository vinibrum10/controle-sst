# Copie este arquivo para ".env" no ambiente local e preencha os valores.
# Em producao (Render), configure estas variaveis em Settings > Environment.

# String de conexao do PostgreSQL (Render Postgres ou outro provedor)
DATABASE_URL="postgresql://usuario:senha@host:5432/controle_sst?schema=public"

# Segredo usado para assinar os tokens JWT de autenticacao.
# Gere um valor aleatorio forte, por exemplo: openssl rand -base64 48
JWT_SECRET="troque-este-valor-por-um-segredo-forte"

# Tempo de expiracao do token de login (formato aceito pelo jsonwebtoken)
JWT_EXPIRES_IN="7d"

# Porta em que o servidor Express vai escutar
PORT=3000

# Ambiente de execucao
NODE_ENV=development

# Configuracao de envio de e-mail (SMTP) usada para notificar
# automaticamente o responsavel quando uma tarefa e criada ou quando
# alguem e designado para apoio. Em producao (Railway), configure estas
# variaveis em Settings > Variables. Sem elas, o envio de e-mail e
# ignorado (com aviso no log) e a criacao da tarefa continua funcionando.
SMTP_HOST="smtp.exemplo.com"
SMTP_PORT=587
SMTP_USER="usuario@exemplo.com"
SMTP_PASS="senha-ou-token-do-smtp"

# Endereco que aparecera como remetente dos e-mails. Se nao definido,
# usa o valor de SMTP_USER.
MAIL_FROM="Controle SST <usuario@exemplo.com>"
