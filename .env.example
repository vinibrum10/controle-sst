# Copie este arquivo para ".env" no ambiente local e preencha os valores.
# Em producao (Render), configure estas variaveis em Settings > Environment.

# String de conexao do PostgreSQL (Render Postgres ou outro provedor)
DATABASE_URL="postgresql://usuario:senha@host:5432/controle_sst?schema=public"

# Segredo usado para assinar os tokens JWT de autenticacao.
# Gere um valor aleatorio forte, por exemplo: openssl rand -base64 48
JWT_SECRET="troque-este-valor-por-um-segredo-forte"

# Tempo de expiracao do token de login (formato aceito pelo jsonwebtoken)
JWT_EXPIRES_IN="7d"

# Porta em que o servidor Express vai escutar
PORT=3000

# Ambiente de execucao
NODE_ENV=development

# ---------------------------------------------------------------------------
# Envio automatico de e-mail (notificacoes de tarefas e pedidos de apoio)
# Se SMTP_HOST/SMTP_USER/SMTP_PASS nao forem definidos, o envio fica desativado
# e o sistema apenas registra a notificacao no log do servidor.
# ---------------------------------------------------------------------------

# Servidor SMTP (ex.: smtp.gmail.com, smtp.office365.com, smtp.sendgrid.net)
SMTP_HOST=

# Porta do servidor SMTP (587 = TLS/STARTTLS, 465 = SSL)
SMTP_PORT=587

# Use "true" para conexao SSL direta (porta 465). Para STARTTLS (587), use "false".
SMTP_SECURE=false

# Usuario e senha de autenticacao no servidor SMTP
SMTP_USER=
SMTP_PASS=

# E-mail exibido como remetente das notificacoes (padrao: SMTP_USER)
SMTP_FROM="SGEPI <no-reply@seudominio.com.br>"
