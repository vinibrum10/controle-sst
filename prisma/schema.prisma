// Modelagem de dados do Controle SST
// Banco: PostgreSQL (Render Postgres)
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// USUARIOS / AUTENTICACAO
// =====================================================================

enum PapelUsuario {
  ADMIN
  GESTOR
  TST
  VISUALIZADOR
  COLABORADOR
}

enum ProvedorAuth {
  LOCAL
  MICROSOFT
}

model Usuario {
  id           String       @id @default(uuid())
  nome         String
  email        String       @unique
  senhaHash    String?
  papel        PapelUsuario @default(COLABORADOR)
  provedor     ProvedorAuth @default(LOCAL)
  provedorId   String?
  ativo        Boolean      @default(true)
  telefone     String?
  cargo        String?
  setor        String?
  avatarUrl    String?
  funcionarioId String?     @unique
  funcionario  Funcionario? @relation(fields: [funcionarioId], references: [id])
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  notificacoes Notificacao[]

  @@index([email])
}

enum ChavePermissao {
  GERENCIAR_EQUIPE
  EXCLUIR_FUNCIONARIO
  GERENCIAR_PROGRAMAS_SST
  GERENCIAR_USUARIOS
  EXPORTAR_DADOS
  IMPORTAR_DADOS
  RESTAURAR_DEMO
  CONFIGURAR_ROTA_SEGURA
  GERENCIAR_EQUIPES_ROTA_SEGURA
  LANCAR_AVALIACAO_ROTA_SEGURA
  DECIDIR_COMITE_ROTA_SEGURA
  EXCLUIR_AVALIACAO_ROTA_SEGURA
}

model PermissaoPerfil {
  id           String         @id @default(uuid())
  papel        PapelUsuario
  chave        ChavePermissao
  permitido    Boolean        @default(false)
  atualizadoEm DateTime       @updatedAt

  @@unique([papel, chave])
  @@index([chave])
}

// Historico de alteracoes na matriz de permissoes (auditoria). Um registro
// e criado para cada combinacao papel+chave cujo valor efetivamente mudou
// em um PATCH /api/permissoes.
model PermissaoHistorico {
  id               String         @id @default(uuid())
  papel            PapelUsuario
  chave            ChavePermissao
  permitidoAntes   Boolean
  permitidoDepois  Boolean
  alteradoPorId    String?
  alteradoPorNome  String?
  alteradoPorEmail String?
  criadoEm         DateTime       @default(now())

  @@index([criadoEm])
}

enum TipoNotificacao {
  TAREFA_ATRIBUIDA
  APOIO_SOLICITADO
  PERMISSAO_ALTERADA
  TAREFA_PRAZO
}

// Notificacoes in-app por usuario. Itens do tipo TAREFA_PRAZO sao calculados
// dinamicamente (nao persistidos) a partir das tarefas com prazo proximo/vencido.
model Notificacao {
  id        String          @id @default(uuid())
  usuarioId String
  usuario   Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  tipo      TipoNotificacao
  titulo    String
  mensagem  String
  link      String?
  lida      Boolean         @default(false)
  criadoEm  DateTime        @default(now())

  @@index([usuarioId, lida])
  @@index([criadoEm])
}

// =====================================================================
// FUNCIONARIOS / EQUIPE SST
// =====================================================================

model Funcionario {
  id        String   @id @default(uuid())
  nome      String
  funcao    String
  email     String   @unique
  capacidade Int     @default(32) // capacidade semanal em horas
  foto      String?  // URL/avatar (ou data URL)
  ativo     Boolean  @default(true)
  criadoEm  DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario Usuario?

  tarefasResponsavel Tarefa[] @relation("TarefaResponsavel")
  tarefasApoio       Tarefa[] @relation("TarefaApoio")

  pedidosAjudaSolicitados PedidoAjuda[] @relation("PedidoAjudaSolicitante")
  pedidosAjudaAtendidos   PedidoAjuda[] @relation("PedidoAjudaAtendente")

  treinamentos Treinamento[] @relation("TreinamentoParticipantes")

  inspecoesResponsavel  Inspecao[]
  auditoriasResponsavel Auditoria[]
  achadosResponsavel    Achado[]
  planosAcaoResponsavel PlanoAcao[]
  rotasSeguraResponsavel RotaSegura[]

  anexosCriados Anexo[]

  @@index([email])
}

// =====================================================================
// SEMANAS
// =====================================================================

model Semana {
  id          String   @id @default(uuid())
  codigo      String   @unique // formato ISO: "2026-W24"
  ano         Int
  numero      Int
  dataInicio  DateTime
  dataFim     DateTime

  tarefas Tarefa[]

  @@index([codigo])
}

// =====================================================================
// TAREFAS
// =====================================================================

enum TipoTarefa {
  ROTINEIRA
  EVENTUAL
}

enum PrioridadeTarefa {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum PeriodoRotina {
  SEMANAL
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum StatusTarefa {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDA
}

model Tarefa {
  id             String           @id @default(uuid())
  titulo         String
  descricao      String?
  responsavelId  String?
  responsavel    Funcionario?     @relation("TarefaResponsavel", fields: [responsavelId], references: [id])
  apoioId        String?
  apoio          Funcionario?     @relation("TarefaApoio", fields: [apoioId], references: [id])
  semanaId       String?
  semana         Semana?          @relation(fields: [semanaId], references: [id])
  prazo          DateTime
  tipo           TipoTarefa       @default(EVENTUAL)
  prioridade     PrioridadeTarefa @default(MEDIA)
  periodoRotina  PeriodoRotina?
  horasEstimadas Int              @default(4)
  status         StatusTarefa     @default(PENDENTE)
  criadoEm       DateTime         @default(now())
  concluidaEm    DateTime?

  pedidosAjuda PedidoAjuda[]
  anexos       Anexo[]

  @@index([responsavelId])
  @@index([semanaId])
  @@index([status])
}

// =====================================================================
// PEDIDOS DE AJUDA / HISTORICO DE AJUDA
// (mesma tabela: pedidos abertos = status ABERTO; historico = consulta
// por status ATENDIDO/CANCELADO ordenada por data)
// =====================================================================

enum StatusPedidoAjuda {
  ABERTO
  ATENDIDO
  CANCELADO
}

model PedidoAjuda {
  id             String            @id @default(uuid())
  tarefaId       String
  tarefa         Tarefa            @relation(fields: [tarefaId], references: [id], onDelete: Cascade)
  solicitanteId  String?
  solicitante    Funcionario?      @relation("PedidoAjudaSolicitante", fields: [solicitanteId], references: [id])
  atendentePorId String?
  atendente      Funcionario?      @relation("PedidoAjudaAtendente", fields: [atendentePorId], references: [id])
  status         StatusPedidoAjuda @default(ABERTO)
  criadoEm       DateTime          @default(now())
  atendidoEm     DateTime?

  @@index([tarefaId])
  @@index([status])
}

// =====================================================================
// TREINAMENTOS
// =====================================================================

enum StatusTreinamento {
  PLANEJADO
  REALIZADO
  CANCELADO
  VENCIDO
}

model Treinamento {
  id              String            @id @default(uuid())
  titulo          String
  descricao       String?
  norma           String?           // ex.: NR-35, NR-33, integracao
  cargaHoraria    Int?
  dataRealizacao  DateTime?
  validade        DateTime?
  status          StatusTreinamento @default(PLANEJADO)
  responsavelId   String?
  responsavel     Funcionario?      @relation("TreinamentoParticipantes", fields: [responsavelId], references: [id])
  criadoEm        DateTime          @default(now())
  atualizadoEm    DateTime          @updatedAt

  anexos Anexo[]

  @@index([status])
}

// =====================================================================
// INSPECOES
// =====================================================================

enum StatusInspecao {
  PLANEJADA
  REALIZADA
  CANCELADA
}

model Inspecao {
  id            String         @id @default(uuid())
  titulo        String
  area          String?
  tipo          String?
  dataPrevista  DateTime
  dataRealizada DateTime?
  status        StatusInspecao @default(PLANEJADA)
  observacoes   String?
  responsavelId String?
  responsavel   Funcionario?   @relation(fields: [responsavelId], references: [id])
  criadoEm      DateTime       @default(now())
  atualizadoEm  DateTime       @updatedAt

  achados Achado[]
  anexos  Anexo[]

  @@index([status])
}

// =====================================================================
// AUDITORIAS
// =====================================================================

enum StatusAuditoria {
  PLANEJADA
  REALIZADA
  CANCELADA
}

model Auditoria {
  id            String          @id @default(uuid())
  titulo        String
  escopo        String?
  norma         String?         // ex.: ISO 45001, NR-XX
  dataPrevista  DateTime
  dataRealizada DateTime?
  status        StatusAuditoria @default(PLANEJADA)
  observacoes   String?
  responsavelId String?
  responsavel   Funcionario?    @relation(fields: [responsavelId], references: [id])
  criadoEm      DateTime        @default(now())
  atualizadoEm  DateTime        @updatedAt

  achados Achado[]
  anexos  Anexo[]

  @@index([status])
}

// =====================================================================
// ACHADOS / DESVIOS
// =====================================================================

enum TipoAchado {
  NAO_CONFORMIDADE
  OBSERVACAO
  OPORTUNIDADE_MELHORIA
}

enum GravidadeAchado {
  BAIXA
  MEDIA
  ALTA
  CRITICA
}

enum StatusAchado {
  ABERTO
  EM_TRATATIVA
  CONCLUIDO
}

model Achado {
  id            String          @id @default(uuid())
  descricao     String
  tipo          TipoAchado      @default(NAO_CONFORMIDADE)
  gravidade     GravidadeAchado @default(MEDIA)
  status        StatusAchado    @default(ABERTO)
  identificadoEm DateTime       @default(now())

  inspecaoId    String?
  inspecao      Inspecao?       @relation(fields: [inspecaoId], references: [id])
  auditoriaId   String?
  auditoria     Auditoria?      @relation(fields: [auditoriaId], references: [id])
  rotaSeguraId  String?
  rotaSegura    RotaSegura?     @relation(fields: [rotaSeguraId], references: [id])

  responsavelId String?
  responsavel   Funcionario?    @relation(fields: [responsavelId], references: [id])

  planosAcao PlanoAcao[]
  anexos     Anexo[]

  @@index([status])
}

// =====================================================================
// PLANOS DE ACAO
// =====================================================================

enum StatusPlanoAcao {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  ATRASADO
}

model PlanoAcao {
  id            String          @id @default(uuid())
  achadoId      String
  achado        Achado          @relation(fields: [achadoId], references: [id], onDelete: Cascade)
  descricao     String
  responsavelId String?
  responsavel   Funcionario?    @relation(fields: [responsavelId], references: [id])
  prazo         DateTime
  status        StatusPlanoAcao @default(PENDENTE)
  concluidoEm   DateTime?
  criadoEm      DateTime        @default(now())

  anexos Anexo[]

  @@index([status])
  @@index([achadoId])
}

// =====================================================================
// ROTAS SEGURAS
// =====================================================================

enum FrequenciaRota {
  DIARIA
  SEMANAL
  QUINZENAL
  MENSAL
}

enum StatusRota {
  ATIVA
  INATIVA
}

model RotaSegura {
  id                String         @id @default(uuid())
  nome              String
  descricao         String?
  area              String?
  frequencia        FrequenciaRota @default(SEMANAL)
  ultimaVerificacao DateTime?
  status            StatusRota     @default(ATIVA)
  responsavelId     String?
  responsavel       Funcionario?   @relation(fields: [responsavelId], references: [id])
  criadoEm          DateTime       @default(now())
  atualizadoEm      DateTime       @updatedAt

  achados Achado[]
  anexos  Anexo[]

  @@index([status])
}

// =====================================================================
// ANEXOS / EVIDENCIAS
// =====================================================================

model Anexo {
  id           String   @id @default(uuid())
  nomeArquivo  String
  url          String
  tipoMime     String?
  tamanho      Int?
  descricao    String?
  criadoEm     DateTime @default(now())

  criadoPorId String?
  criadoPor   Funcionario? @relation(fields: [criadoPorId], references: [id])

  tarefaId      String?
  tarefa        Tarefa?      @relation(fields: [tarefaId], references: [id])
  treinamentoId String?
  treinamento   Treinamento? @relation(fields: [treinamentoId], references: [id])
  inspecaoId    String?
  inspecao      Inspecao?    @relation(fields: [inspecaoId], references: [id])
  auditoriaId   String?
  auditoria     Auditoria?   @relation(fields: [auditoriaId], references: [id])
  achadoId      String?
  achado        Achado?      @relation(fields: [achadoId], references: [id])
  planoAcaoId   String?
  planoAcao     PlanoAcao?   @relation(fields: [planoAcaoId], references: [id])
  rotaSeguraId  String?
  rotaSegura    RotaSegura?  @relation(fields: [rotaSeguraId], references: [id])

  rsAprAvaliacaoId String?
  rsAprAvaliacao   RsAprAvaliacao? @relation(fields: [rsAprAvaliacaoId], references: [id])
  rsPenalidadeId   String?
  rsPenalidade     RsPenalidade?   @relation(fields: [rsPenalidadeId], references: [id])
}

// =====================================================================
// ROTA SEGURA (programa anual de seguranca: edicoes, propostas, criterios
// de pontuacao, regras condicionais, premiacao, equipes, avaliacoes de
// APR, comite e penalidades). A regra do Rota Segura muda todo ano, por
// isso os criterios/pontuacoes/regras/proposta/premiacao sao configuraveis
// por edicao (RsEdicaoPrograma) em vez de fixos no codigo. A edicao 2026
// (foco em avaliacao de APR) e criada via seed como a primeira edicao.
// =====================================================================

enum RsAreaEquipe {
  LINHAS_LIMPEZA_FAIXA
  EAT
  PCC
  UFV
  OUTRO
}

enum RsTipoApr {
  AMOSTRAL
  FORMS
}

enum RsTipoInfracao {
  LEVE
  GRAVE
  GRAVISSIMA
}

enum RsTipoRevisaoComite {
  RISCOS_ADICIONAIS
  MEDIDAS_ADICIONAIS
}

enum RsDecisaoComite {
  PENDENTE
  APROVADO
  REPROVADO
}

enum RsTipoCriterio {
  PROATIVO
  REATIVO
}

enum RsCategoriaCriterio {
  APR
  VIDEO
  INSPECAO
  DDS
  TREINAMENTO
  TRANSITO
  COMPORTAMENTO
  PENALIDADE
  OUTRO
}

// Tipos de regra condicional suportados pelo motor de pontuacao:
// - REQUER_CRITERIO_APROVADO: o criterio so pontua se "criterioDependente"
//   tiver sido concedido na mesma avaliacao (ex.: riscos/medidas adicionais
//   dependem da APR estar com aprovacao basica / erro zero).
// - BLOQUEADO_PARA_TIPO_APR: o criterio nao se aplica a um tipo de APR
//   (parametros: { "tipoApr": "FORMS" | "AMOSTRAL" }). Usado para
//   documentar regras tambem refletidas em aplicaAmostral/aplicaForms.
// - LIMITE_MENSAL_POR_EQUIPE: documenta o limite de avaliacoes por
//   tipo/mes/equipe (parametros: { "tipoApr": "FORMS", "limite": 1 }).
//   A aplicacao e garantida pela constraint unica de RsAprAvaliacao.
enum RsTipoCondicao {
  REQUER_CRITERIO_APROVADO
  BLOQUEADO_PARA_TIPO_APR
  LIMITE_MENSAL_POR_EQUIPE
}

// Edicao anual do programa Rota Segura. Cada edicao tem sua propria
// proposta, criterios de pontuacao, regras condicionais e premiacao,
// permitindo que o programa mude de foco (APR, videos, DDS, etc.) sem
// alteracoes de codigo.
model RsEdicaoPrograma {
  id           String    @id @default(uuid())
  nome         String
  ano          Int       @unique
  slogan       String?
  objetivo     String?
  descricao    String?
  dataInicio   DateTime?
  dataFim      DateTime?
  ativo        Boolean   @default(true)
  observacoes  String?
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  proposta    RsProposta?
  criterios   RsCriterio[]
  regras      RsRegraCondicional[]
  premiacoes  RsPremiacao[]
  avaliacoes  RsAprAvaliacao[]
  penalidades RsPenalidade[]

  @@index([ativo])
}

// Proposta/regulamento oficial da edicao, consultavel dentro do app.
model RsProposta {
  id                 String           @id @default(uuid())
  edicaoId           String           @unique
  edicao             RsEdicaoPrograma @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  titulo             String?
  slogan             String?
  mensagemAbertura   String?
  objetivoGeral      String?
  justificativa      String?
  publicoAlvo        String?
  areasParticipantes String?
  regrasGerais       String?
  criteriosAvaliacao String?
  estruturaComite    String?
  regraPremiacao     String?
  premios            String?
  cronograma         String?
  observacoes        String?
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt
}

// Criterio de pontuacao da edicao. "codigo" identifica criterios que o
// motor de calculo (server/utils/rotaSegura2026.js) sabe interpretar
// automaticamente (ex.: APR_ERRO_ZERO, RISCOS_ADICIONAIS_APROVADOS,
// MEDIDAS_ADICIONAIS_APROVADAS, PENALIDADE_LEVE/GRAVE/GRAVISSIMA).
// Criterios sem codigo reconhecido servem como documentacao/configuracao
// para futuras edicoes e categorias (videos, DDS, inspecoes, etc.).
model RsCriterio {
  id             String              @id @default(uuid())
  edicaoId       String
  edicao         RsEdicaoPrograma    @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  codigo         String?
  nome           String
  descricao      String?
  tipo           RsTipoCriterio
  pontuacao      Int
  categoria      RsCategoriaCriterio @default(OUTRO)
  exigeComite    Boolean             @default(false)
  exigeEvidencia Boolean             @default(false)
  aplicaAmostral Boolean             @default(true)
  aplicaForms    Boolean             @default(true)
  ativo          Boolean             @default(true)
  ordem          Int                 @default(0)
  criadoEm       DateTime @default(now())
  atualizadoEm   DateTime @updatedAt

  regrasOrigem      RsRegraCondicional[] @relation("CriterioOrigem")
  regrasDependencia RsRegraCondicional[] @relation("CriterioDependente")

  @@index([edicaoId])
  @@index([categoria])
}

// Dependencia/regra entre criterios da mesma edicao (ver RsTipoCondicao).
model RsRegraCondicional {
  id                   String           @id @default(uuid())
  edicaoId             String
  edicao               RsEdicaoPrograma @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  criterioId           String
  criterio             RsCriterio       @relation("CriterioOrigem", fields: [criterioId], references: [id], onDelete: Cascade)
  criterioDependenteId String?
  criterioDependente   RsCriterio?      @relation("CriterioDependente", fields: [criterioDependenteId], references: [id])
  tipoCondicao         RsTipoCondicao
  parametros           Json?
  descricao            String?
  ativo                Boolean          @default(true)
  criadoEm             DateTime @default(now())
  atualizadoEm         DateTime @updatedAt

  @@index([edicaoId])
}

// Configuracao de premiacao por area/especialidade da edicao.
model RsPremiacao {
  id              String           @id @default(uuid())
  edicaoId        String
  edicao          RsEdicaoPrograma @relation(fields: [edicaoId], references: [id], onDelete: Cascade)
  area            RsAreaEquipe
  quantidade      Int
  posicaoInicial  Int
  posicaoFinal    Int
  descricaoPremio String
  observacoes     String?
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  @@index([edicaoId])
}

model RsEquipe {
  id           String       @id @default(uuid())
  nome         String
  area         RsAreaEquipe @default(OUTRO)
  supervisor   String?
  tst          String?
  ativo        Boolean      @default(true)
  observacoes  String?
  criadoEm     DateTime     @default(now())
  atualizadoEm DateTime     @updatedAt

  colaboradores RsColaborador[]
  avaliacoes    RsAprAvaliacao[]
  penalidades   RsPenalidade[]

  @@index([area])
  @@index([ativo])
}

model RsColaborador {
  id           String    @id @default(uuid())
  nome         String
  matricula    String?
  funcao       String?
  equipeId     String?
  equipe       RsEquipe? @relation(fields: [equipeId], references: [id])
  ativo        Boolean   @default(true)
  criadoEm     DateTime  @default(now())
  atualizadoEm DateTime  @updatedAt

  penalidades RsPenalidade[]

  @@index([equipeId])
  @@index([ativo])
}

// Avaliacao mensal de APR de uma equipe. A combinacao equipe+mes+tipo e
// unica: cada equipe pode ter no maximo 1 APR amostral e 1 APR via Forms
// por mes de referencia (edicao do registro existente continua permitida).
model RsAprAvaliacao {
  id            String           @id @default(uuid())
  edicaoId      String
  edicao        RsEdicaoPrograma @relation(fields: [edicaoId], references: [id])
  mesReferencia String // formato "AAAA-MM"
  dataAvaliacao DateTime
  equipeId      String
  equipe        RsEquipe  @relation(fields: [equipeId], references: [id])
  tipo          RsTipoApr
  numeroOs      String?
  numeroApr     String?
  atividade     String?
  local         String?
  avaliador     String?
  observacoes   String?

  // Checklist da APR
  cabecalhoOk      Boolean @default(false)
  enderecoOk       Boolean @default(false)
  assinaturasOk    Boolean @default(false)
  riscosMinimosOk  Boolean @default(false)
  medidasMinimasOk Boolean @default(false)
  coerenciaOk      Boolean @default(false)
  arquivadaEam     Boolean @default(false)
  legivel          Boolean @default(false)
  aprovacaoBasica  Boolean @default(false)

  // Pontuacao adicional sujeita a analise do comite
  riscosAdicionais           Boolean         @default(false)
  riscosAdicionaisDescricao  String?
  riscosAdicionaisComite     RsDecisaoComite @default(PENDENTE)
  medidasAdicionais          Boolean         @default(false)
  medidasAdicionaisDescricao String?
  medidasAdicionaisComite    RsDecisaoComite @default(PENDENTE)

  // Pontuacao proativa calculada automaticamente (ver server/utils/rotaSegura2026.js)
  pontuacao Int @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  anexos         Anexo[]
  decisoesComite RsComiteDecisao[]

  @@unique([edicaoId, equipeId, mesReferencia, tipo])
  @@index([edicaoId])
  @@index([equipeId])
  @@index([mesReferencia])
}

// Historico de decisoes do comite sobre riscos/medidas adicionais (auditoria).
model RsComiteDecisao {
  id          String              @id @default(uuid())
  avaliacaoId String
  avaliacao   RsAprAvaliacao      @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  tipo        RsTipoRevisaoComite
  decisao     RsDecisaoComite
  responsavel String?
  dataDecisao DateTime            @default(now())
  observacoes String?

  @@index([avaliacaoId])
}

// Penalidades reativas (infracoes leves/graves/gravissimas).
model RsPenalidade {
  id             String           @id @default(uuid())
  edicaoId       String
  edicao         RsEdicaoPrograma @relation(fields: [edicaoId], references: [id])
  mesReferencia  String
  equipeId       String
  equipe         RsEquipe       @relation(fields: [equipeId], references: [id])
  colaboradorId  String?
  colaborador    RsColaborador? @relation(fields: [colaboradorId], references: [id])
  tipo           RsTipoInfracao
  pontos         Int
  descricao      String
  dataOcorrencia DateTime
  responsavel    String?
  observacoes    String?
  criadoEm       DateTime       @default(now())
  atualizadoEm   DateTime       @updatedAt

  anexos Anexo[]

  @@index([edicaoId])
  @@index([equipeId])
  @@index([mesReferencia])
}
